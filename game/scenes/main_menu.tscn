text = "[ 01 // KEYBOARD & MOUSE CONTROLS ]"

[node name="KeysText" type="Label" parent="MenuUI/ControlsModal/Center/Panel/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.94, 0.98, 1)
theme_override_font_sizes/font_size = 13
text = "• W, A, S, D / Arrow Keys : 3D Player Movement
• Left Shift (Hold) : Sprint Boost (1.8x movement velocity)
• Spacebar : Jump & Traverse Architectural Steps
• Mouse Movement : 360-Degree Free Camera Look
• E : Interact with Faculty Guide (Prof. Sharma), Pickup ID Card, Open/Close Doors
• Escape / Q : Pause Walkthrough & Access In-Game Operations Menu"

[node name="Sec2" type="Label" parent="MenuUI/ControlsModal/Center/Panel/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.72, 0.35, 1)
theme_override_font_sizes/font_size = 14
text = "[ 02 // CAMPUS DIRECTORY & LANDMARKS ]"

[node name="DirText" type="Label" parent="MenuUI/ControlsModal/Center/Panel/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 13
text = "• Main Entrance Gate : Security Cabin & Parking Zone (Vehicles 1 to 6)
• Main Academic Plinth : High-pillar portico and dual entrance doors
• Ground Floor Lobby : Prof. Sharma's Orientation Station & Lost ID Card
• Classroom 101 & Computer Lab : Ground floor west wing
• Grand Central Staircase : Wide ramp and steps leading to Floor 2
• Second Floor Classroom 201 : Advanced lecture room
• Seminar Hall : Grand 150-seat conference theater on Floor 2
• Central Library : Reading halls, book stacks & study carrels"

